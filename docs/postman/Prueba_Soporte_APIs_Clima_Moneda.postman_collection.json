        {
          "name": "Ciudades de un país",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde en menos de 3 segundos\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "pm.test(\"La respuesta es JSON\", () => pm.response.to.be.json);",
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Contiene data\", () => pm.expect(pm.response.json()).to.have.property(\"data\"));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"Top 10 más pobladas ordenado de mayor a menor\", () => {",
                  "    const pops = d.top_most.map(c => c.population);",
                  "    pm.expect(pops).to.eql([...pops].sort((a, b) => b - a));",
                  "    pm.expect(pops.length).to.be.at.most(10);",
                  "});"
                ]
              }
            }
